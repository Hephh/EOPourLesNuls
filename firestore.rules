rules_version = '2';

// Règles de sécurité Firestore d'« EOPour les nuls ».
// Elles ne s'appliquent qu'une fois collées dans la console Firebase :
// Firestore Database → onglet Règles → tout remplacer par ce fichier → Publier.
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins : UID copiés depuis le profil du site (ou Authentication → Utilisateurs).
    // 2WA3n1y7a0O103qDwYrqB5y2nTp2 = Sébastien (propriétaire)
    function estAdmin() {
      return request.auth != null && request.auth.uid in ['2WA3n1y7a0O103qDwYrqB5y2nTp2'];
    }

    function profilValide(d) {
      return d.keys().hasOnly(['nom', 'photo', 'avatar', 'favoris', 'scores', 'activite', 'creeLe', 'vuLe'])
        && (!('nom' in d) || (d.nom is string && d.nom.size() > 0 && d.nom.size() <= 40))
        && (!('photo' in d) || d.photo == null
            || (d.photo is string && d.photo.size() <= 600
                && d.photo.matches('https://lh[0-9][.]googleusercontent[.]com/.*')))
        && (!('avatar' in d) || d.avatar == null || (d.avatar is string && d.avatar.size() <= 16))
        && (!('favoris' in d) || (d.favoris is list && d.favoris.size() <= 500))
        && (!('scores' in d) || (d.scores is map && d.scores.size() <= 500))
        && (!('activite' in d) || (d.activite is map && d.activite.size() <= 400))
        && (!('creeLe' in d) || d.creeLe is timestamp)
        && (!('vuLe' in d) || d.vuLe is timestamp);
    }

    // Catalogue du site (années, matières, place des outils) : tout le monde le lit, seul l'admin l'écrit.
    function catalogueValide(d) {
      return d.keys().hasOnly(['annees', 'matieres', 'outils', 'masques', 'majLe'])
        && d.annees is list && d.annees.size() <= 40
        && d.matieres is list && d.matieres.size() <= 400
        && d.outils is map && d.outils.size() <= 1000
        && (!('masques' in d) || (d.masques is map && d.masques.size() <= 1000))
        && (!('majLe' in d) || d.majLe is timestamp);
    }
    match /site/catalogue {
      allow read: if true;
      allow write: if estAdmin() && catalogueValide(request.resource.data);
    }

    // Chaque membre lit et écrit uniquement son profil ; l'admin peut tout lire.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || estAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && profilValide(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
