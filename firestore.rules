rules_version = '2';

// Règles de sécurité Firestore d'« EOPour les nuls ».
// Publiées avec le site : firebase deploy --only hosting,firestore:rules (voir CLAUDE.md).
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins : UID copiés depuis le profil du site (ou Authentication → Utilisateurs).
    // 2WA3n1y7a0O103qDwYrqB5y2nTp2 = Sébastien (propriétaire)
    function estAdmin() {
      return request.auth != null && request.auth.uid in ['2WA3n1y7a0O103qDwYrqB5y2nTp2'];
    }

    // Photo de profil importée : petite image en data URL (≤ 90 000 caractères, réduite à 256 px par le site).
    function imageValide(d) {
      return !('image' in d) || d.image == null
        || (d.image is string && d.image.size() <= 90000 && d.image.matches('data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+'));
    }

    function profilValide(d) {
      return d.keys().hasOnly(['nom', 'photo', 'avatar', 'image', 'favoris', 'scores', 'activite', 'revisions', 'creeLe', 'vuLe'])
        && (!('revisions' in d) || (d.revisions is map && d.revisions.size() <= 3000))
        && imageValide(d)
        && (!('nom' in d) || (d.nom is string && d.nom.size() > 0 && d.nom.size() <= 40))
        && (!('photo' in d) || d.photo == null
            || (d.photo is string && d.photo.size() <= 600
                && d.photo.matches('https://lh[0-9][.]googleusercontent[.]com/.*')))
        && (!('avatar' in d) || d.avatar == null || (d.avatar is string && d.avatar.size() <= 16))
        && (!('favoris' in d) || (d.favoris is list && d.favoris.size() <= 500))
        && (!('scores' in d) || (d.scores is map && d.scores.size() <= 500))
        && (!('activite' in d) || (d.activite is map && d.activite.size() <= 400))
        && (!('creeLe' in d) || d.creeLe is timestamp)
        && (!('vuLe' in d) || d.vuLe is timestamp);
    }

    // Catalogue du site (années, matières, place des outils) : tout le monde le lit, seul l'admin l'écrit.
    function catalogueValide(d) {
      return d.keys().hasOnly(['annees', 'matieres', 'outils', 'masques', 'annonce', 'images', 'majLe'])
        && (!('annonce' in d) || d.annonce == null || (d.annonce is map && d.annonce.size() <= 6))
        && (!('images' in d) || (d.images is map && d.images.size() <= 1000))
        && d.annees is list && d.annees.size() <= 40
        && d.matieres is list && d.matieres.size() <= 400
        && d.outils is map && d.outils.size() <= 1000
        && (!('masques' in d) || (d.masques is map && d.masques.size() <= 1000))
        && (!('majLe' in d) || d.majLe is timestamp);
    }
    match /site/catalogue {
      allow read: if true;
      allow write: if estAdmin() && catalogueValide(request.resource.data);
    }

    // Médiathèque de l'admin (images des matières, catégories, schémas, QCM) : lue par tous.
    match /medias/{id} {
      allow read: if true;
      allow create, update: if estAdmin()
        && request.resource.data.keys().hasOnly(['data', 'nom', 'le'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 950000
        && request.resource.data.data.matches('data:image/(webp|jpeg|png);base64,.*');
      allow delete: if estAdmin();
    }

    // Contenus créés depuis l'admin (QCM, fiches et schémas) : lus par tous.
    match /contenus/{id} {
      allow read: if true;
      allow create, update: if estAdmin()
        && request.resource.data.keys().hasOnly(['type', 'titre', 'questions', 'blocs', 'majLe'])
        && request.resource.data.type in ['qcm', 'fiche']
        && request.resource.data.questions is list && request.resource.data.questions.size() <= 300
        && request.resource.data.blocs is list && request.resource.data.blocs.size() <= 300;
      allow delete: if estAdmin();
    }

    // Profil public : nom et avatar, lus par les membres connectés, écrits par leur propriétaire.
    match /profils/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nom', 'photo', 'avatar', 'image', 'majLe'])
        && imageValide(request.resource.data)
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 40
        && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() <= 600
            && request.resource.data.photo.matches('https://lh[0-9][.]googleusercontent[.]com/.*')))
        && (request.resource.data.avatar == null || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 16));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Commentaires d'un outil : lus par les membres connectés ; chacun écrit les siens ; l'auteur ou l'admin supprime.
    match /commentaires/{outil}/liste/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['de', 'nom', 'photo', 'avatar', 'texte', 'le'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.texte is string && request.resource.data.texte.size() > 0 && request.resource.data.texte.size() <= 500
        && request.resource.data.nom is string && request.resource.data.nom.size() <= 40
        && request.resource.data.le == request.time;
      allow delete: if request.auth != null && (resource.data.de == request.auth.uid || estAdmin());
    }

  }
}
